<%= form_with model: product, html: { class: "form-card" } do |form| %>
    <% if form.object.errors.any? %>
        <p class="error"><%= form.object.errors.full_messages.first %></p>
    <% end %>

    <div>
        <%= form.label :name %>
        <%= form.text_field :name %>
    </div>

    <div>
        <%= form.label :description, style: "display: block;" %>
        <%= form.rich_textarea :description %>
    </div>

    <div>
        <%= form.label :featured_image %>
        <%= form.file_field :featured_image, accept: "image/*" %>
    </div>

    <div>
        <%= form.label :inventory_count, style: "display: block" %>
        <%= form.number_field :inventory_count %>
    </div>

    <div class="actions">
        <%= form.submit product.persisted? ? t(".update_submit") : t(".create_submit"), class: "btn btn-primary" %>
        <%= link_to t(".cancel"), cancel_path, class: "btn btn-secondary" %>
    </div>
<% end %>