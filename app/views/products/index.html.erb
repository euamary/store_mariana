<h1><%= t ".title" %></h1>

<%= link_to t(".new_product"), new_product_path if authenticated? %>
<%= link_to t(".login"), new_session_path unless authenticated? %>

<div id="products">
  <% @products.each do |product| %>
    <div>
      <%= link_to product.name, product_path(product.id) %>
    </div>
  <% end %>
</div>