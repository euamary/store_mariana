<div class="stock-info">
  <% if product.inventory_count.positive? %>
    <p class="in-stock"><%= product.inventory_count %> in stock</p>
  <% else %>
    <p class="out-of-stock">Out of stock</p>
    <p>Email me when available.</p>

    <%= form_with model: [ product, Subscriber.new ], html: { class: "subscribe-form" } do |form| %>
      <%= form.email_field :email, placeholder: "you@example.com", required: true %>
      <%= form.submit "Submit", class: "btn btn-primary" %>
    <% end %>
  <% end %>
</div>