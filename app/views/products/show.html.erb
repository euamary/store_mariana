<% cache @product do %>
    <h1><%= @product.name %></h1>
    <%= @product.description %>
    <%= image_tag @product.featured_image if @product.featured_image.attached? %>
<% end %>

<%= link_to t(".back"), products_path %>
<% if authenticated? %>
    <%= link_to t(".edit"), edit_product_path(@product) %>
    <%= button_to t(".delete"), @product, method: :delete, data: { turbo_confirm: t(".confirm_delete") } %>
<% end %>