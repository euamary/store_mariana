<div class="product-detail">
  <% cache @product do %>
      <h1><%= @product.name %></h1>
      <%= @product.description %>
      <%= image_tag @product.featured_image if @product.featured_image.attached? %>
  <% end %>

  <%= render "inventory", product: @product %>

<div class="action">
  <%= link_to t(".back"), products_path, class: "btn btn-secondary" %>
  <% if authenticated? %>
      <%= link_to t(".edit"), edit_product_path(@product), class: "btn btn-secondary" %>
      <%= button_to t(".delete"), @product, method: :delete, class: "btn btn-danger", form_class: "delete-action", data: { turbo_confirm: t(".confirm_delete") } %>
  <% end %>
</div>